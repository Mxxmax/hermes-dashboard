+@app.post("/api/model/fetch-models")
+def fetch_models(body: FetchModelsBody):
+    """Proxy a `/v1/models` request to an external API (avoids CORS in browser).
+
+    Accepts ``base_url`` and optional ``api_key``, calls
+    ``{base_url}/models`` with Bearer auth, and returns the model list.
+    """
+    import httpx
+
+    base_url = body.base_url.rstrip("/")
+    api_key = body.api_key.strip() if body.api_key else ""
+    headers = {"Content-Type": "application/json"}
+    if api_key:
+        headers["Authorization"] = f"Bearer {api_key}"
+
+    try:
+        resp = httpx.get(f"{base_url}/models", headers=headers, timeout=15)
+        resp.raise_for_status()
+        data = resp.json()
+        models = [m["id"] for m in data.get("data", []) if isinstance(m, dict)]
+        return {"models": models}
+    except httpx.HTTPStatusError as e:
+        detail = str(e.response.text[:300]) if e.response.text else str(e)
+        raise HTTPException(status_code=e.response.status_code, detail=detail)
+    except httpx.RequestError as e:
+        raise HTTPException(status_code=502, detail=f"Request failed: {e}")
+    except Exception as e:
+        _log.exception("POST /api/model/fetch-models failed")
+        raise HTTPException(status_code=500, detail=str(e))
+
